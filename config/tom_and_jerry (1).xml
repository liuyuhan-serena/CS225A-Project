<!-- <robotControlConfiguration robotName="FrankaRobot" robotModelFile="${SAI_MODEL_URDF_FOLDER}/panda/panda_arm.urdf"> -->
<robotControlConfiguration robotName="Titania" robotModelFile="${ROBOT_FILES_FOLDER}/Rizon4s.urdf">

	<logger logFolderName="log_files/single_panda/controllers"
		enabledAtStartup="true"
		addTimestampToFilename="false" />

	<controller name="cartesian_controller">
		<motionForceTask name="cartesian_task" linkName="flange">
            <compliantFrame xyz="0 0 0.15" rpy="0 0 0" />
			<velocitySaturation enabled="false"
				linearVelocityLimit="0.1"
				angularVelocityLimit="0.5" />
			<otg type="acceleration"
				maxLinearVelocity="0.30"
				maxAngularVelocity="1.0"
				maxLinearAcceleration="0.5"
				maxLinearJerk="5.0"
				maxAngularAcceleration="1.0" 
				maxAngularJerk="100"/>

				<!-- <otg type="acceleration"
				maxLinearVelocity="0.15"
				maxAngularVelocity="1.0" 
				maxLinearAcceleration="1.5"
				maxLinearJerk="5.0"
				maxAngularAcceleration="3.0" 
				maxAngularJerk="100"/> -->

            <positionGains kp="400.0" kv="40.0" />
            <orientationGains kp="400.0" kv="40.0" />
		</motionForceTask>

		<jointTask name="joint_task">
			<otg type="disabled" />
		</jointTask>
	</controller>

	<controller name="joint_controller">
		<jointTask name="joint_task">
			<velocitySaturation enabled="true" />
			<otg type="disabled" />
		</jointTask>
	</controller>

</robotControlConfiguration>