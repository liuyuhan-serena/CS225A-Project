<?xml version="1.0"?>
<!-- ======================================================================== -->
<!-- | Flexiv Rizon 4s + rigid Grav gripper (no mimic, visual-identical)    | -->
<!-- | Gripper fingers frozen at fully-open pose. SAI2-friendly.            | -->
<!-- ======================================================================== -->

<robot name="rizon4s">

  <mujoco>
    <compiler meshdir="./" strippath="false" balanceinertia="true" discardvisual="false" fusestatic="true"/>
  </mujoco>

  <!-- ====================================================================== -->
  <!-- ARM                                                                    -->
  <!-- ====================================================================== -->

  <link name="base_link">
    <inertial>
      <mass value="3.7"/>
      <origin rpy="0 0 0" xyz="0.0 -0.0 0.09"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="0.0" izz="0.02"/>
    </inertial>
    <visual name="shell">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/visual/link0.obj"/>
      </geometry>
      <material name="rizon_light_grey"/>
    </visual>
  </link>

  <link name="link1">
    <inertial>
      <mass value="3.7"/>
      <origin rpy="0 0 0" xyz="0.0 0.01 0.15"/>
      <inertia ixx="0.03" ixy="0.0" ixz="0.0" iyy="0.03" iyz="0.0" izz="0.03"/>
    </inertial>
    <visual name="shell">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/visual/link1.obj"/>
      </geometry>
      <material name="rizon_light_grey"/>
    </visual>
    <visual name="ring">
      <origin rpy="0 0 0" xyz="0 0 -0.0025"/>
      <geometry>
        <mesh filename="rizon4s/visual/ring.obj" scale="0.062 0.062 0.002"/>
      </geometry>
      <material name="rizon_white"/>
    </visual>
  </link>

  <link name="link2">
    <inertial>
      <mass value="2.7"/>
      <origin rpy="0 0 0" xyz="0.0 0.04 0.1"/>
      <inertia ixx="0.02" ixy="0.0" ixz="0.0" iyy="0.02" iyz="-0.0" izz="0.02"/>
    </inertial>
    <visual name="shell">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/visual/link2.obj"/>
      </geometry>
      <material name="rizon_light_grey"/>
    </visual>
    <visual name="ring">
      <origin rpy="1.5707963 0 0" xyz="0 -0.0025 0"/>
      <geometry>
        <mesh filename="rizon4s/visual/ring.obj" scale="0.062 0.062 0.002"/>
      </geometry>
      <material name="rizon_white"/>
    </visual>
  </link>

  <link name="link3">
    <inertial>
      <mass value="2.4"/>
      <origin rpy="0 0 0" xyz="-0.01 -0.0 0.13"/>
      <inertia ixx="0.01" ixy="0.0" ixz="-0.0" iyy="0.01" iyz="-0.0" izz="0.01"/>
    </inertial>
    <visual name="shell">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/visual/link3.obj"/>
      </geometry>
      <material name="rizon_light_grey"/>
    </visual>
    <visual name="ring">
      <origin rpy="0 0 0" xyz="0 0 -0.0025"/>
      <geometry>
        <mesh filename="rizon4s/visual/ring.obj" scale="0.051 0.051 0.002"/>
      </geometry>
      <material name="rizon_white"/>
    </visual>
  </link>

  <link name="link4">
    <inertial>
      <mass value="2.4"/>
      <origin rpy="0 0 0" xyz="-0.01 0.03 0.1"/>
      <inertia ixx="0.02" ixy="0.0" ixz="-0.0" iyy="0.02" iyz="-0.0" izz="0.02"/>
    </inertial>
    <visual name="shell">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/visual/link4.obj"/>
      </geometry>
      <material name="rizon_light_grey"/>
    </visual>
    <visual name="ring">
      <origin rpy="1.5707963 0 0" xyz="0 -0.0025 0"/>
      <geometry>
        <mesh filename="rizon4s/visual/ring.obj" scale="0.051 0.051 0.002"/>
      </geometry>
      <material name="rizon_white"/>
    </visual>
  </link>

  <link name="link5">
    <inertial>
      <mass value="2.4"/>
      <origin rpy="0 0 0" xyz="-0.0 0.0 0.13"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
    <visual name="shell">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/visual/link5.obj"/>
      </geometry>
      <material name="rizon_light_grey"/>
    </visual>
    <visual name="ring">
      <origin rpy="0 0 0" xyz="0 0 -0.0025"/>
      <geometry>
        <mesh filename="rizon4s/visual/ring.obj" scale="0.051 0.051 0.002"/>
      </geometry>
      <material name="rizon_white"/>
    </visual>
  </link>

  <link name="link6">
    <inertial>
      <mass value="2.1"/>
      <origin rpy="0 0 0" xyz="-0.01 0.06 0.07"/>
      <inertia ixx="0.01" ixy="-0.0" ixz="-0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
    <visual name="shell">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/visual/link6.obj"/>
      </geometry>
      <material name="rizon_light_grey"/>
    </visual>
    <visual name="ring">
      <origin rpy="1.5707963 0 0" xyz="0 -0.0025 0"/>
      <geometry>
        <mesh filename="rizon4s/visual/ring.obj" scale="0.051 0.051 0.002"/>
      </geometry>
      <material name="rizon_white"/>
    </visual>
  </link>

  <link name="link7">
    <inertial>
      <mass value="1.4"/>
      <origin rpy="0 0 0" xyz="0.0 0.0 0.05"/>
      <inertia ixx="0.01" ixy="0.0" ixz="0.0" iyy="0.01" iyz="0.0" izz="0.01"/>
    </inertial>
    <visual name="shell">
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/visual/link7.obj"/>
      </geometry>
      <material name="rizon_light_grey"/>
    </visual>
    <visual name="ring">
      <origin rpy="1.5707963 0 0" xyz="0 -0.0025 0"/>
      <geometry>
        <mesh filename="rizon4s/visual/ring.obj" scale="0.051 0.051 0.002"/>
      </geometry>
      <material name="rizon_white"/>
    </visual>
    <visual name="camera">
      <origin rpy="1.5717 3.1415 1.5717" xyz="0.045 0 0.046"/>
      <geometry>
        <mesh filename="rizon4s/visual/d405-camera-mount.obj" scale="1 1 1"/>
      </geometry>
      <material name="rizon_white"/>
    </visual>
    <visual name="left-eye">
      <origin rpy="0 0 0" xyz="0.074 -0.01 0.136"/>
      <geometry>
        <sphere radius="0.005"/>
      </geometry>
      <material name="rizon_blue">
        <color rgba="0.0 0.0 1.0 0.5"/>
      </material>
    </visual>
  </link>

  <link name="flange">
    <inertial>
      <mass value="0.0001"/>
      <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
      <inertia ixx="0.001" ixy="0.0" ixz="-0.0" iyy="0.001" iyz="-0.0" izz="0.001"/>
    </inertial>
  </link>

  <!-- joints with calibration rising for EE-down initial pose -->
  <joint name="joint1" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin rpy="0.0 0.0 -3.141592653589793" xyz="0.0 0.0 0.155"/>
    <axis xyz="0 0 1"/>
    <limit effort="123" lower="-2.7925" upper="2.7925" velocity="2.0944"/>
    <calibration rising="0"/>
  </joint>
  <joint name="joint2" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.03 0.21"/>
    <axis xyz="0 1 0"/>
    <limit effort="123" lower="-2.2689" upper="2.2689" velocity="2.0944"/>
    <calibration rising="-0.5236"/>
  </joint>
  <joint name="joint3" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.035 0.205"/>
    <axis xyz="0 0 1"/>
    <limit effort="64" lower="-2.9671" upper="2.9671" velocity="2.4435"/>
    <calibration rising="0"/>
  </joint>
  <joint name="joint4" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin rpy="0.0 0.0 -3.141592653589793" xyz="-0.02 -0.03 0.19"/>
    <axis xyz="0 1 0"/>
    <limit effort="64" lower="-1.8675" upper="2.6878" velocity="2.4435"/>
    <calibration rising="1.5708"/>
  </joint>
  <joint name="joint5" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin rpy="0.0 0.0 -3.141592653589793" xyz="-0.02 0.025 0.195"/>
    <axis xyz="0 0 1"/>
    <limit effort="39" lower="-2.9671" upper="2.9671" velocity="4.8869"/>
    <calibration rising="0"/>
  </joint>
  <joint name="joint6" type="revolute">
    <parent link="link5"/>
    <child link="link6"/>
    <origin rpy="0.0 0.0 0.0" xyz="0.0 0.03 0.19"/>
    <axis xyz="0 1 0"/>
    <limit effort="39" lower="-1.3963" upper="4.5379" velocity="4.8869"/>
    <calibration rising="1.0472"/>
  </joint>
  <joint name="joint7" type="revolute">
    <parent link="link6"/>
    <child link="link7"/>
    <origin rpy="0.0 -1.5707963478683205 0.0" xyz="-0.015 0.073 0.11"/>
    <axis xyz="0 0 1"/>
    <limit effort="39" lower="-2.9671" upper="2.9671" velocity="4.8869"/>
    <calibration rising="0"/>
  </joint>
  <joint name="link7_to_flange" type="fixed">
    <parent link="link7"/>
    <child link="flange"/>
    <origin rpy="0.0 0.0 -3.141592653589793" xyz="0.0 0.0 0.124"/>
  </joint>

  <!-- ====================================================================== -->
  <!-- GRIPPER: rigid, fully-open pose, no mimic                              -->
  <!-- ====================================================================== -->

  <link name="grav_base_link">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.057"/>
      <mass value="1.186"/>
      <inertia ixx="3E-3" ixy="0" ixz="0" iyy="3E-3" iyz="0" izz="1E-3"/>
    </inertial>
    <visual>
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/Grav/visual/base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="flexiv_black"/>
    </visual>
    <collision>
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/Grav/collision/base.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="gripper_base_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="flange"/>
    <child link="grav_base_link"/>
  </joint>

  <!-- left finger (all fixed) -->
  <link name="left_outer_bar">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.029"/>
      <mass value="1E-4"/>
      <inertia ixx="1E-7" ixy="0" ixz="0" iyy="1E-7" iyz="0" izz="1E-7"/>
    </inertial>
    <visual>
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/Grav/visual/outer_bar.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="flexiv_black"/>
    </visual>
    <collision>
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/Grav/collision/outer_bar.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="left_outer_knuckle_joint" type="fixed">
    <origin rpy="-0.155 0 0" xyz="0 -0.0325 0.0825"/>
    <parent link="grav_base_link"/>
    <child link="left_outer_bar"/>
  </joint>

  <link name="left_inner_bar">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.029"/>
      <mass value="1E-4"/>
      <inertia ixx="1E-7" ixy="0" ixz="0" iyy="1E-7" iyz="0" izz="1E-7"/>
    </inertial>
    <visual>
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/Grav/visual/inner_bar.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="flexiv_black"/>
    </visual>
    <collision>
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/Grav/collision/inner_bar.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="left_inner_knuckle_joint" type="fixed">
    <origin rpy="-0.155 0 0" xyz="0 -0.0165 0.0995"/>
    <parent link="grav_base_link"/>
    <child link="left_inner_bar"/>
  </joint>

  <link name="left_finger_mount">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1E-4"/>
      <inertia ixx="1E-7" ixy="0" ixz="0" iyy="1E-7" iyz="0" izz="1E-7"/>
    </inertial>
    <visual>
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/Grav/visual/finger_mount.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="flexiv_black"/>
    </visual>
  </link>
  <joint name="left_inner_finger_joint" type="fixed">
    <origin rpy="0.155 0 0" xyz="0 0 0.058"/>
    <parent link="left_outer_bar"/>
    <child link="left_finger_mount"/>
  </joint>

  <link name="left_finger_tip">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1E-4"/>
      <inertia ixx="1E-7" ixy="0" ixz="0" iyy="1E-7" iyz="0" izz="1E-7"/>
    </inertial>
    <visual>
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/Grav/visual/finger_tip.obj" scale="0.001 0.001 0.001"/>
      </geometry>
    </visual>
    <collision>
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/Grav/collision/finger_tip.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
  </link>
  <joint name="left_inner_finger_pad_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0.010 0.0235"/>
    <parent link="left_finger_mount"/>
    <child link="left_finger_tip"/>
  </joint>

  <link name="left_finger_tcp">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1E-4"/>
      <inertia ixx="1E-7" ixy="0" ixz="0" iyy="1E-7" iyz="0" izz="1E-7"/>
    </inertial>
  </link>
  <joint name="left_finger_tcp_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0.0135 0.036"/>
    <parent link="left_finger_tip"/>
    <child link="left_finger_tcp"/>
  </joint>

  <!-- right finger (all fixed) -->
  <link name="right_outer_bar">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0.029"/>
      <mass value="1E-4"/>
      <inertia ixx="1E-7" ixy="0" ixz="0" iyy="1E-7" iyz="0" izz="1E-7"/>
    </inertial>
    <visual>
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
        <mesh filename="rizon4s/Grav/visual/outer_bar.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="flexiv_black"/>
    </visual>
    <collision>
      <origin rpy="0 0 1.5707963267948966" xyz="0 0 0"/>
      <geometry>
